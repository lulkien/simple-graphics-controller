#!/bin/sh
# Runs before the package is removed: stop the daemon and stop it coming back.
set -e

if [ -d /run/systemd/system ] && [ "$1" = remove ]; then
    systemctl --system stop simple-graphics-controller.service >/dev/null || true
    deb-systemd-helper disable simple-graphics-controller.service >/dev/null || true
    systemctl --system daemon-reload >/dev/null || true
fi
